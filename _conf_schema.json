  "expand_process": {"description": "默认展开处理过程", "type": "bool", "default": false},
  "show_tools": {"description": "显示工具调用摘要", "type": "bool", "default": true},
  "show_sources": {"description": "显示知识与数据来源", "type": "bool", "default": true},
  "show_usage": {"description": "显示模型与用量", "type": "bool", "default": true},
